@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor White
  BorderColor Navy
  ArrowColor DarkGreen
}
skinparam actor {
  BackgroundColor White
  BorderColor Black
}

actor "Étudiant" as etudiant

rectangle "Système de Gestion Étudiante" {
  usecase "S'authentifier" as UC1
  usecase "S'inscrire" as UC2
  usecase "Consulter l'emploi du temps" as UC3
  usecase "Consulter les notes" as UC4
  usecase "Scanner QR Code" as UC5
  usecase "Marquer la présence" as UC6
  usecase "Se déconnecter" as UC7
}

etudiant --> UC1
etudiant --> UC2
etudiant --> UC3
etudiant --> UC4
etudiant --> UC5
etudiant --> UC7

UC1 ..> UC2 : <<extend>>

UC3 ..> UC1 : <<include>>
UC4 ..> UC1 : <<include>>
UC5 ..> UC1 : <<include>>
UC6 ..> UC5 : <<include>>

note right of UC3
  Nécessite authentification
end note

note right of UC4
  Nécessite authentification
end note

note right of UC5
  Nécessite authentification
end note

note bottom of UC1
  Authentification requise pour :
  - Consulter emploi
  - Consulter notes
  - Scanner QR Code
end note

@enduml